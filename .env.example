# 이 파일을 .env.local 로 복사해서 쓴다. (.env / .env.* 는 .gitignore·.dockerignore 양쪽에서 막혀 있다)
#
# ⚠️ 이 값은 `npm run build` 시점에 번들 문자열로 박힌다. 런타임에 바뀌지 않는다.
#    Cloud Run 콘솔의 "변수 및 보안 비밀" 에 넣어봐야 아무 효과 없다 —
#    최종 이미지는 nginx 가 정적 dist/ 만 서빙해서 환경변수를 읽을 JS 런타임이 없다.
#
# 배포 이미지의 값은 이 파일이 아니라 Dockerfile 의 `ARG VITE_API_BASE_URL` 기본값에서 온다.
# (.dockerignore 가 .env 계열을 빌드 컨텍스트에서 제외하므로 이 파일은 이미지에 안 들어간다.)

# 로컬 백엔드로 붙을 때
VITE_API_BASE_URL=http://localhost:8080

# 배포된 백엔드로 붙을 때
# VITE_API_BASE_URL=https://back-end-git-145786632792.asia-northeast3.run.app
